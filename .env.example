# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on (hosts like Render set this for you)
PORT=3000

# Where leads are saved. Point this at a persistent disk when you deploy.
DATA_DIR=./data

# Admin page at /admin (turned off until you set a password)
ADMIN_USER=nerses
ADMIN_PASSWORD=change-this-to-a-long-password

# Email notification for each new inquiry (optional)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password as SMTP_PASS
NOTIFY_TO=name@example.com
MAIL_FROM=name@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
